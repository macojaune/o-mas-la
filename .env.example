# Dedicated development values only. Never copy production credentials/data into local tests.
# See docs/development.md for the local setup and the complete validation commands.
DB_URL=file:./.cache/omasla-auth.db
DB_TOKEN=

# Auth.js. Generate a unique secret per environment; configure a provider before login.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Apple Services ID and signed client-secret JWT (renew before expiry, <= 6 months).
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
# Brevo transactional API key and an authorized sender address. No email is sent without both.
AUTH_BREVO_API_KEY=
AUTH_EMAIL_FROM=

# Public origin of the auth service; HTTPS outside local development.
AUTH_ISSUER_URL=http://localhost:3185
# Auth.js canonical origin; must equal AUTH_ISSUER_URL exactly (no trailing slash).
AUTH_URL=http://localhost:3185
# PKCS8 PEM (quoted with escaped newlines) used to sign short-lived Convex tokens.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_KEY_ID=local-development

# These URLs must all identify the same isolated Convex deployment.
# Never set CONVEX_DEPLOYMENT or CONVEX_DEPLOY_KEY to production for local development.
CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
EXPO_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
EXPO_PUBLIC_API_URL=http://localhost:3185
NEXT_PUBLIC_APP_URL=http://localhost:3185
PORT=3185

# Browser map token is public and must have appropriate origin restrictions.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Android native maps key. Restrict to the application/signing certificate.
GOOGLE_MAPS_API_KEY=

# Explicit opt-in on a deployed environment, disabled for development and QA.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
